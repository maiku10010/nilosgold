# Supabase PostgreSQL connection string used by Prisma's pg adapter.
# Use your Supabase pooler connection string for serverless deployments.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGIN="http://localhost:5173,https://nilosgoldui.vercel.app"

# Generate a unique random value of at least 32 characters. Keep this secret.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Optional primary gold feed (24K PHP per gram). Never expose this key to the UI.
# On failure or when absent: Gold-API.com XAU/USD + ExchangeRate-API daily USD/PHP.
# Successful quotes cache for 5 minutes; outages may use the last quote for up to 24h.
GOLD_API_KEY="replace-with-your-goldapi-key"
# GOLD_API_URL="https://www.goldapi.io/api/XAU/PHP"

# Resend email configuration used for receipts and ready-for-pickup notices.
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Nilo's Goldsmith <receipts@your-verified-domain.example>"
