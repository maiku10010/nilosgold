# Dedicated demo Supabase only. Never copy the shop production credentials.
# Runtime: transaction pooler, port 6543. URL-encode the password.
DATABASE_URL="postgresql://postgres.<demo-project-ref>:<password>@<pooler-host>:6543/postgres"
# Schema/seed: direct IPv6 or session pooler (port 5432).
DIRECT_URL="postgresql://postgres.<demo-project-ref>:<password>@<pooler-host>:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://<demo-project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<demo-publishable-or-legacy-anon-key>"

NEXT_PUBLIC_APP_NAME="GoldDemo"
APP_CONTACT="Contact our demo shop to arrange collection."
APP_RECEIPT_FOOTER="Thank you for supporting our craft."
CORS_ORIGIN="http://localhost:5173,https://golddemo-five.vercel.app"
AUTH_COOKIE_NAME="goldsmith_demo_session"
AUTH_SECRET="replace-with-a-new-random-secret-at-least-32-characters"

# Optional live gold feed; server-side only.
# GOLD_API_KEY="<your-key>"
# Email is disabled until BOTH values are configured. Demo addresses use example.com.
# RESEND_API_KEY="<demo-resend-key>"
# EMAIL_FROM="GoldDemo <receipts@your-verified-domain.example>"

# One-time local setup ONLY; omit all DEMO_* variables from Vercel.
DEMO_ALLOW_SEED="false"
DEMO_DATABASE_HOST="<exact-host-from-demo-DIRECT_URL>"
# DEMO_ADMIN_PASSWORD="<private-password-12-to-72-bytes>"

# Pin deployed demo connections to this project's own reference.
# DEMO_SUPABASE_PROJECT_REF="<demo-project-ref>"
# DATABASE_SSL_CA="<PEM contents of the official Supabase CA certificate>"
