# Supabase PostgreSQL connection string used by Prisma's pg adapter.
# Use your Supabase pooler connection string for serverless deployments.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Optional comma-separated list of frontend origins allowed to call this API.
CORS_ORIGIN="http://localhost:5173"
