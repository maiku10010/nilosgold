// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  clientId   String @id @default(uuid())
  clientName String
  contactNum String
  balance    Decimal @default(0.00)

  sale Sales[]
}

model Sales {
  invoiceId   String @id @default(uuid())
  serviceType String
  price       Decimal  @default(0.00)
  status      String
  downpayment Decimal  @default(0.00)
  salesDate   DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [clientId])

  jobs Job_Cost?
}

model Inventory {
  referenceId String @id @default(uuid())
  goldIn      Decimal @default(0.00)
  goldOut     Decimal @default(0.00)
  stones      Decimal @default(0.00)
  totalGold   Decimal @default(0.00)
}

model Job_Cost {
  jobCostId String @id @default(uuid())
  goldUsed  Decimal @default(0.00)
  laborCost Decimal @default(0.00)

  invoiceId String   @unique
  sale      Sales @relation(fields: [invoiceId], references: [invoiceId])

  empId    String
  employee Employee @relation(fields: [empId], references: [empId])
}

model Employee {
  empId    String @id @default(uuid())
  empName  String
  workdays Int
  empRole  String
  rates    Decimal @default(0.00)

  jobs Job_Cost[]
}

model Expenses {
  expenseId   String @id @default(uuid())
  category    String
  amount      Decimal  @default(0.00)
  description String
  expDate     DateTime @default(now())
}

model Inquiries {
  inquiryId   String @id @default(uuid())
  category    String
  inqDate     DateTime @default(now())
  quotedPrice Decimal  @default(0.00)
  closed      Boolean
}
