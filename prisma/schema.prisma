// Prisma schema for the existing Supabase database.
// Keep the mapped table/column names aligned with Supabase; IDs are generated
// by the API in a readable YYYY-M-D-T### format for new records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InquiryStatus {
  PENDING
  APPROVED
  REJECTED
  FINISHED
}

enum JobStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  READY_FOR_PICKUP
  FINISHED
  CANCELLED
}

enum SalesStatus {
  PENDING
  PAID
  PARTIAL
  FINISHED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InventoryCategory {
  GOLD
  SILVER
  GEMSTONES
  BOXES
  PACKAGING
  FINDINGS
  TOOLS

  @@map("inventory_category")
}

model Client {
  clientId   String  @id
  clientName String
  contactNum String?
  email      String?

  inquiries Inquiries[]
  sales     Sales[]
  jobCosts  Job_Cost[]
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Employee {
  empId     String    @id
  empName   String
  empRole   String
  rates     Decimal
  userName  String    @unique
  password  String
  deletedAt DateTime?

  jobs             Job_Cost[]
  sessions         AuthSession[]
  auditLogs        SystemLog[]       @relation("LogActor")
  approvalRequests ApprovalRequest[] @relation("ApprovalRequester")
  approvalReviews  ApprovalRequest[] @relation("ApprovalReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

model Inquiries {
  inquiryId    String        @id
  universalReferenceId String? @unique @map("universal_reference_id")
  isFullyPaid Boolean @default(false)
  category     String
  /// Whole-number karat, 10 through 24; NULL means unspecified.
  goldKarat    Int? @db.SmallInt @map("gold_karat")
  quotedPrice  Decimal
  customerName String
  contactInfo  String?
  email        String?
  details      String?
  status       InquiryStatus @default(PENDING)
  inqDate      DateTime      @default(now()) @map("date")

  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [clientId], onDelete: SetNull)
  deletedAt DateTime?

  // One inquiry can create at most one costing record.
  jobCost Job_Cost?

  @@map("inquiries")
}

model Job_Cost {
  jobCostId       String    @id
  universalReferenceId String? @unique @map("universal_reference_id")
  itemName        String?   @map("item_name")
  deadline        DateTime? @map("delivery_date")
  goldUsed        Decimal   @default(0.00)
  /// Whole-number karat, 10 through 24; enforced by the SQL migration.
  goldKarat       Int? @db.SmallInt @map("gold_karat")
  goldScrap       Decimal   @default(0.00) @map("gold_scrap")
  stoneCost       Decimal   @default(0.00)
  laborCost       Decimal   @default(0.00)
  laborCharge     Decimal   @default(0.00) @map("labor_charge")
  otherCost       Decimal   @default(0.00) @map("other_cost")
  sourceDataComplete Boolean @default(true) @map("source_data_complete")
  sourceNotes String? @map("source_notes")
  goldCostPerG    Decimal   @default(0.00) @db.Decimal(12, 2)
  status          JobStatus @default(IN_PROGRESS)
  jobDate         DateTime? @default(now()) @map("date")
  readyNotifiedAt DateTime?
  deletedAt       DateTime?

  empId    String?
  employee Employee? @relation(fields: [empId], references: [empId], onDelete: SetNull)
  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [clientId], onDelete: SetNull)

  inquiryId String?    @unique
  inquiry   Inquiries? @relation(fields: [inquiryId], references: [inquiryId], onDelete: SetNull)

  // A sale is created when the costing is finished. The sale stores the
  // invoice number and client relation used by the UI to match name + invoice.
  sales Sales?
  inventoryMovement Inventory[] @relation("JobCostInventoryMovement")
  sourceSheet String? @map("source_sheet")
  sourceRow Int? @map("source_row")

  @@unique([sourceSheet, sourceRow])

  @@map("job_costs")
}

model Sales {
  invoiceId     String      @id
  universalReferenceId String? @unique @map("universal_reference_id")
  serviceType   String
  price         Decimal
  status        SalesStatus @default(PAID)
  salesDate     DateTime    @default(now()) @map("date")
  receiptSentAt DateTime?
  deletedAt     DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [clientId], onDelete: Restrict)

  // One sale can be linked to one costing; uniqueness prevents duplicate sales.
  jobCostId String?   @unique
  job       Job_Cost? @relation(fields: [jobCostId], references: [jobCostId], onDelete: SetNull)
  payments SalePayment[]
  sourceSheet String? @map("source_sheet")
  sourceRow Int? @map("source_row")
  sourceInvoiceNumber String? @map("source_invoice_number")
  sourceDate String? @map("source_date")
  sourceStatus String? @map("source_status")
  sourceType String? @map("source_type")

  @@unique([sourceSheet, sourceRow])

  @@map("sales")
}

model Inventory {
  referenceId String    @id
  universalReferenceId String? @map("universal_reference_id")
  itemName    String
  unit        String
  unitPrice   Decimal   @default(0.00)
  category    InventoryCategory @default(GOLD)
  /// Only GOLD may have a karat; NULL preserves unknown historical purity.
  goldKarat   Int? @db.SmallInt @map("gold_karat")
  quantityIn  Decimal   @default(0.00)
  quantityOut Decimal   @default(0.00)
  quantityLoss Decimal  @default(0.00)
  updatedAt   DateTime  @default(now()) @map("date")
  deletedAt   DateTime?

  jobCostId   String?
  jobCost     Job_Cost? @relation("JobCostInventoryMovement", fields: [jobCostId], references: [jobCostId], onDelete: SetNull)
  sourceSheet String? @map("source_sheet")
  sourceRow Int? @map("source_row")
  sourceDate String? @map("source_date")

  @@unique([sourceSheet, sourceRow])

  @@map("inventory")
}

model Expenses {
  expenseId   String    @id
  category    String
  amount      Decimal
  description String?
  expDate     DateTime  @default(now()) @map("date")
  deletedAt   DateTime?
  sourceSheet String? @map("source_sheet")
  sourceRow Int? @map("source_row")

  @@unique([sourceSheet, sourceRow])

  @@map("expenses")
}

model SalePayment {
  paymentId String @id @map("payment_id")
  invoiceId String @map("invoice_id")
  amount Decimal @db.Decimal(12, 2)
  paidAt DateTime? @map("paid_at")
  paymentNumber Int? @map("payment_number")
  method String?
  notes String?
  sourceSheet String? @map("source_sheet")
  sourceRow Int? @map("source_row")
  sale Sales @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)

  @@unique([sourceSheet, sourceRow, paymentNumber])
  @@index([invoiceId, paidAt])
  @@map("sale_payments")
}

model AuthSession {
  id        String    @id
  empId     String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  employee  Employee  @relation(fields: [empId], references: [empId], onDelete: Cascade)

  @@index([empId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model SystemLog {
  logId      String    @id @default(cuid())
  actorEmpId String?
  actorName  String
  actorRole  String
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  actor      Employee? @relation("LogActor", fields: [actorEmpId], references: [empId], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorEmpId, createdAt(sort: Desc)])
  @@map("system_logs")
}

model ApprovalRequest {
  requestId      String         @id @default(cuid())
  entityType     String
  entityId       String
  action         String
  beforeData     Json?
  proposedData   Json?
  status         ApprovalStatus @default(PENDING)
  requesterEmpId String
  reviewerEmpId  String?
  reviewerNote   String?
  createdAt      DateTime       @default(now())
  reviewedAt     DateTime?
  requester      Employee       @relation("ApprovalRequester", fields: [requesterEmpId], references: [empId], onDelete: Restrict)
  reviewer       Employee?      @relation("ApprovalReviewer", fields: [reviewerEmpId], references: [empId], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([entityType, entityId, status])
  @@map("approval_requests")
}

// Historical invoices deliberately keep assumed settlements separate from cash.
// Nullable money supports pulled-out records without creating zero-value sales.
model LegacyInvoice {
  recordId             String   @id @map("record_id")
  legacyInvoice        String   @map("legacy_invoice")
  sourceFile           String   @map("source_file")
  sourceRow            Int      @map("source_row")
  invoiceDate          DateTime? @db.Date @map("invoice_date")
  dateEstimated        Boolean  @default(false) @map("date_estimated")
  customerName         String?  @map("customer_name")
  description          String?
  status               String
  pulledOut            Boolean  @default(false) @map("pulled_out")
  salePrice            Decimal? @db.Decimal(18, 2) @map("sale_price")
  recordedPayment      Decimal? @db.Decimal(18, 2) @map("recorded_payment")
  assumedPayment       Decimal? @db.Decimal(18, 2) @map("assumed_payment")
  reconciledPayment    Decimal? @db.Decimal(18, 2) @map("reconciled_payment")
  balance              Decimal? @db.Decimal(18, 2)
  excessPayment        Decimal? @db.Decimal(18, 2) @map("excess_payment")
  excessClassification String?  @map("excess_classification")
  sourceRows           LegacySheetRow[]

  @@unique([sourceFile, sourceRow])
  @@index([legacyInvoice])
  @@index([invoiceDate, status])
  @@map("legacy_invoices")
}

// All ten files, including reports, corrections, item lines and deferred stock.
// This is provenance/staging, not an additional sale/payment/inventory ledger.
model LegacySheetRow {
  recordId        String @id @map("record_id")
  sourceFile      String @map("source_file")
  sourceRow       Int    @map("source_row")
  sourceSha256    String @map("source_sha256")
  processing      String
  invoiceRecordId String? @map("invoice_record_id")
  invoice         LegacyInvoice? @relation(fields: [invoiceRecordId], references: [recordId], onDelete: Restrict)
  originalData    Json   @map("original_data")
  cleanedData     Json   @map("cleaned_data")

  @@unique([sourceFile, sourceRow])
  @@index([invoiceRecordId])
  @@map("legacy_sheet_rows")
}
