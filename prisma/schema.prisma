// Prisma schema for the existing Supabase database.
// Keep the mapped table/column names aligned with Supabase; IDs are generated
// by the API in a readable YYYY-M-D-T### format for new records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InquiryStatus {
  PENDING
  APPROVED
  REJECTED
  FINISHED
}

enum JobStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  READY_FOR_PICKUP
  FINISHED
  CANCELLED
}

enum SalesStatus {
  PENDING
  PAID
  PARTIAL
  FINISHED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Client {
  clientId   String  @id
  clientName String
  contactNum String?
  email      String?
  balance    Decimal @default(0.00)

  inquiries Inquiries[]
  sales     Sales[]
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Employee {
  empId     String    @id
  empName   String
  empRole   String
  rates     Decimal
  userName  String    @unique
  password  String
  deletedAt DateTime?

  jobs             Job_Cost[]
  sessions         AuthSession[]
  auditLogs        SystemLog[]       @relation("LogActor")
  approvalRequests ApprovalRequest[] @relation("ApprovalRequester")
  approvalReviews  ApprovalRequest[] @relation("ApprovalReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

model Inquiries {
  inquiryId    String        @id
  category     String
  quotedPrice  Decimal
  customerName String
  contactInfo  String?
  email        String?
  details      String?
  status       InquiryStatus @default(PENDING)
  inqDate      DateTime      @default(now()) @map("date")

  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [clientId], onDelete: SetNull)
  deletedAt DateTime?

  // One inquiry can create at most one costing record.
  jobCost Job_Cost?

  @@map("inquiries")
}

model Job_Cost {
  jobCostId       String    @id
  itemName        String?   @map("item_name")
  deadline        DateTime? @map("delivery_date")
  goldUsed        Decimal   @default(0.00)
  stoneCost       Decimal   @default(0.00)
  laborCost       Decimal   @default(0.00)
  goldCostPerG    Decimal   @default(0.00)
  status          JobStatus @default(IN_PROGRESS)
  jobDate         DateTime  @default(now()) @map("date")
  readyNotifiedAt DateTime?
  deletedAt       DateTime?

  empId    String
  employee Employee @relation(fields: [empId], references: [empId], onDelete: Restrict)

  inquiryId String?    @unique
  inquiry   Inquiries? @relation(fields: [inquiryId], references: [inquiryId], onDelete: SetNull)

  // A sale is created when the costing is finished. The sale stores the
  // invoice number and client relation used by the UI to match name + invoice.
  sales Sales?

  @@map("job_costs")
}

model Sales {
  invoiceId     String      @id
  serviceType   String
  price         Decimal
  downpayment   Decimal     @default(0.00)
  status        SalesStatus @default(PAID)
  salesDate     DateTime    @default(now()) @map("date")
  receiptSentAt DateTime?
  deletedAt     DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [clientId], onDelete: Restrict)

  // One sale can be linked to one costing; uniqueness prevents duplicate sales.
  jobCostId String?   @unique
  job       Job_Cost? @relation(fields: [jobCostId], references: [jobCostId], onDelete: SetNull)

  @@map("sales")
}

model Inventory {
  referenceId String    @id
  itemName    String
  unit        String
  goldIn      Decimal   @default(0.00)
  goldOut     Decimal   @default(0.00)
  scraps      Decimal   @default(0.00)
  totalGold   Decimal   @default(0.00)
  updatedAt   DateTime  @updatedAt @map("date")
  deletedAt   DateTime?

  @@map("inventory")
}

model Expenses {
  expenseId   String    @id
  category    String
  amount      Decimal
  description String?
  expDate     DateTime  @default(now()) @map("date")
  deletedAt   DateTime?

  @@map("expenses")
}

model AuthSession {
  id        String    @id
  empId     String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  employee  Employee  @relation(fields: [empId], references: [empId], onDelete: Cascade)

  @@index([empId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model SystemLog {
  logId      String    @id @default(cuid())
  actorEmpId String?
  actorName  String
  actorRole  String
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  actor      Employee? @relation("LogActor", fields: [actorEmpId], references: [empId], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorEmpId, createdAt(sort: Desc)])
  @@map("system_logs")
}

model ApprovalRequest {
  requestId      String         @id @default(cuid())
  entityType     String
  entityId       String
  action         String
  beforeData     Json?
  proposedData   Json?
  status         ApprovalStatus @default(PENDING)
  requesterEmpId String
  reviewerEmpId  String?
  reviewerNote   String?
  createdAt      DateTime       @default(now())
  reviewedAt     DateTime?
  requester      Employee       @relation("ApprovalRequester", fields: [requesterEmpId], references: [empId], onDelete: Restrict)
  reviewer       Employee?      @relation("ApprovalReviewer", fields: [reviewerEmpId], references: [empId], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([entityType, entityId, status])
  @@map("approval_requests")
}
