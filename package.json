{
  "name": "nilosgold",
  "version": "1.0.0",
  "description": "Configurable goldsmith operations API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "test": "node --test tests/*.test.cjs",
    "check": "prisma generate && prisma validate && npm run demo:check && npm run build && npm test",
    "test:receipt": "npm run build && node --test tests/receipt.test.cjs",
    "start": "node dist/index.js",
    "vercel-build": "npm run check",
    "demo:bootstrap": "node scripts/bootstrap-demo.cjs",
    "demo:seed": "prisma db seed",
    "demo:check": "tsc --project prisma/tsconfig.seed.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maiku10010/nilosgold.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/maiku10010/nilosgold/issues"
  },
  "homepage": "https://github.com/maiku10010/nilosgold#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
